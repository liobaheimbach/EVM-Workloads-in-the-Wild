# Copy this file to .env and fill in your values
# OUTPUT_BASE_DIR: base directory used to derive the default --input-base
# ($OUTPUT_BASE_DIR/opcode_breakdown) and default --output-dir
# ($OUTPUT_BASE_DIR/evm_workload_analysis_data/opcode_breakdown).
# Not needed if both --input-base and --output-dir are given on the command line.
OUTPUT_BASE_DIR=/path/to/output_data
