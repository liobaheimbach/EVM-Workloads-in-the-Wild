# === Secrets / local config ===
# Never commit a real .env (RPC URLs, API keys, data roots).
.env
*.env
!.env.example
# The committed rpc_config.json files contain only YOUR_*_RPC_URL placeholders.
# If you fill them with real archive-node URLs, do NOT commit that change:
#   git update-index --assume-unchanged <path>/rpc_config.json
# (uncomment the next line if you prefer to ignore them entirely)
# **/rpc_config.json

# === Data outputs (CSV / Parquet / DuckDB) ===
# Collection writes per-block CSVs, date-partitioned Parquet, and DuckDB metadata.
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.db
# date-partitioned output trees
**/date=*/
block_*_opcode_gas.csv
block_*_opcode_breakdown.csv
0x*_opcode_breakdown.csv
*_blocks_summary.csv
*_timestamps.json

# === Logs / caches / scratch ===
*.log
logs/
cache/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
duckdb_tmp/
*.tmp

# === Scraped label dumps (regenerated by the labels/ scrapers; do not commit) ===
# Keep these IGNORED so large scraped snapshots aren't committed. If a curated
# label CSV is meant to ship, force-add it: git add -f <file>
addresses_with_categories*.csv
etherscan_labels_*.csv
basescan_labels_*.csv
spellbook*.csv
defillama*.csv
kleros*.csv

# === OS / editor ===
.DS_Store
*.swp
.vscode/
.idea/
